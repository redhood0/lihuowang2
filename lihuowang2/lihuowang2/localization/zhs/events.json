{
  "LIHUOWANG2_EVENT_LIHUOWANG2_HOSPITAL_STAGE1.title": "第二附属医院",
  "LIHUOWANG2_EVENT_LIHUOWANG2_HOSPITAL_STAGE1.pages.INITIAL.description": "你[sine]晕乎乎[/sine]的睁开了眼，刺鼻的消毒水味充满了整个空间。你发现身处在一个熟悉而又陌生的医院中，[jitter]全身上下都被捆了起来[/jitter]。几个穿着白大褂的人围着你似乎在说着什么，你决定……",
  "LIHUOWANG2_EVENT_LIHUOWANG2_HOSPITAL_STAGE1.pages.INITIAL.options.YELL_NOSICK.title": "（否认）",
  "LIHUOWANG2_EVENT_LIHUOWANG2_HOSPITAL_STAGE1.pages.INITIAL.options.YELL_NOSICK.description": "[大喊][jitter]“我没病！”[/jitter]",
  "LIHUOWANG2_EVENT_LIHUOWANG2_HOSPITAL_STAGE1.pages.INITIAL.options.YELL_SICK.title": "（崩溃）",
  "LIHUOWANG2_EVENT_LIHUOWANG2_HOSPITAL_STAGE1.pages.INITIAL.options.YELL_SICK.description": "[大喊][jitter]“我有病，我有病啊！”[/jitter]",
  "LIHUOWANG2_EVENT_LIHUOWANG2_HOSPITAL_STAGE1.pages.INITIAL.options.YELL_MOTHER.title": "（求助）",
  "LIHUOWANG2_EVENT_LIHUOWANG2_HOSPITAL_STAGE1.pages.INITIAL.options.YELL_MOTHER.description": "[大喊][sine]“妈~我分不清啊！”[/sine]",
  "LIHUOWANG2_EVENT_LIHUOWANG2_HOSPITAL_STAGE1.pages.SEDATE.description": "穿白大褂的医生看你[jitter]情绪似乎太过激动[/jitter]，给你打了一针镇定剂……",
  "LIHUOWANG2_EVENT_LIHUOWANG2_HOSPITAL_STAGE1.pages.SEDATE.options.GET_ANDING.title": "获得安定。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_HOSPITAL_STAGE1.pages.SEDATE.options.GET_ANDING.description": "将“安定”加入你的卡组。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_HOSPITAL_STAGE1.pages.OUT.description": "你再次觉得[sine]晕乎乎[/sine]的，[scramble]渐渐分不清楚幻觉和现实[/scramble]，眼前一黑，又再次陷入昏睡……",
  "LIHUOWANG2_EVENT_LIHUOWANG2_CAVE4_DALI_DAN1.title": "深山洞府",
  "LIHUOWANG2_EVENT_LIHUOWANG2_CAVE4_DALI_DAN1.pages.INITIAL.description": "你发现自己身处一处幽暗的洞穴之中，迎面走来一群身着麻衣的青年男女，其中为首的一个自称“玄阳”的青年拿着火匣子催促你和他一起“走”。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_CAVE4_DALI_DAN1.pages.INITIAL.options.GO_WITH.title": "“走？原来你们是要……”",
  "LIHUOWANG2_EVENT_LIHUOWANG2_CAVE4_DALI_DAN1.pages.INITIAL.options.GO_WITH.description": "",
  "LIHUOWANG2_EVENT_LIHUOWANG2_CAVE4_DALI_DAN1.pages.INITIAL.options.REPORT.title": "反方向快速溜走，向癞子头师傅打小报告。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_CAVE4_DALI_DAN1.pages.INITIAL.options.REPORT.description": "",
  "LIHUOWANG2_EVENT_LIHUOWANG2_CAVE4_DALI_DAN1.pages.YUPEI.description": "话没说完，就被玄阳众人捂住嘴打晕捆住，丢在一边，慌乱中拽下了玄阳的玉佩……",
  "LIHUOWANG2_EVENT_LIHUOWANG2_CAVE4_DALI_DAN1.pages.YUPEI.options.GET_YUPEI.title": "获得玄阳玉佩。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_CAVE4_DALI_DAN1.pages.YUPEI.options.GET_YUPEI.description": "将“玄阳玉佩”加入你的遗物。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_CAVE4_DALI_DAN1.pages.DALI.description": "师傅念你举报有功，奖赏了你一些丹药。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_CAVE4_DALI_DAN1.pages.DALI.options.GET_DALI_DAN.title": "获得大力丹。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_CAVE4_DALI_DAN1.pages.DALI.options.GET_DALI_DAN.description": "将“大力丹”加入你的卡组。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_CAVE4_DALI_DAN1.pages.END.description": "玄阳一众潜逃的弟子被师傅逮住，悉数斩杀。师傅指派你当新的“玄阳”，你两眼一黑……",
  "LIHUOWANG2_EVENT_LIHUOWANG2_AO_JING_JIAO2.title": "祆景教洞府",
  "LIHUOWANG2_EVENT_LIHUOWANG2_AO_JING_JIAO2.pages.INITIAL.description": "为了解决丹阳子的隐患，你来到了祆景教的洞府。在祆景教徒的带领下，见到一个浑身焦黑被一根根带血的竹根刺穿了整个身体的人。他自称手叁，答应帮你解决丹阳子的问题，但是需要你先给他们演示一遍心素进行“苍蜣登阶”的过程。为了帮助你达到内心的极致的痛苦，他们给你安排了一个叫姜英子的侍女与你行男女之事，之后……",
  "LIHUOWANG2_EVENT_LIHUOWANG2_AO_JING_JIAO2.pages.INITIAL.options.ASK_DETAILS.title": "和手叁探讨交流祆景教的教义和“苍蜣登阶”的细节。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_AO_JING_JIAO2.pages.INITIAL.options.ASK_DETAILS.description": "",
  "LIHUOWANG2_EVENT_LIHUOWANG2_AO_JING_JIAO2.pages.INITIAL.options.RESCUE.title": "太残忍了，和姜英子偷偷计划逃离这里。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_AO_JING_JIAO2.pages.INITIAL.options.RESCUE.description": "",
  "LIHUOWANG2_EVENT_LIHUOWANG2_AO_JING_JIAO2.pages.TRUE_MEANING.description": "手叁告诉了你残卷上极度痛苦的登阶条件是“1生命0手牌0能量……”你看着他嘴一张一闭，明明在讲话，却难以理解他的意思，两眼一黑晕了过去……",
  "LIHUOWANG2_EVENT_LIHUOWANG2_AO_JING_JIAO2.pages.RESCUE_DONE.description": "你不忍心让姜英子受人所害，企图带她偷偷逃跑。但是不知为何计划败露，姜英子被人带走。带刺的钩子从她琵琶骨穿过，将她身体整个吊了起来。你不顾自身伤势，一根指甲飞了出去，直接斩断了挂住英子的锁链，把她救了下来。获救的姜英子为了表达她的感谢，把火袄真经还有使用的方法教给了你。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_AO_JING_JIAO2.pages.RESCUE_DONE.options.GET_BOOK.title": "获得火袄真经。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_AO_JING_JIAO2.pages.RESCUE_DONE.options.GET_BOOK.description": "将“火袄真经”加入你的卡组。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_AO_JING_JIAO2.pages.BOOK_RECEIVED.description": "你伸手接了那被半透明腊液包裹的古怪书籍，透过凝固的腊液，原来这本书的名字是《火袄箴经》。发现里面由各种圆圈形成的文字，大圈套小圈，小圈里面还有小点，陷入了幻觉……",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.title": "龙门寨水匪",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.INITIAL.description": "前进的路被一群水匪堵住了，你选择？",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.INITIAL.options.YIELD.title": "（认怂）",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.INITIAL.options.YIELD.description": "[认怂] 失去所有[gold]金钱[/gold]。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.INITIAL.options.FIGHT.title": "（战斗）",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.INITIAL.options.FIGHT.description": "杀光他们！！！！",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.YIELD_DONE.description": "乖乖把身上的钱全都交给了水匪，水匪放过了你。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.YIELD_DONE.options.LEAVE.title": "离开。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.YIELD_DONE.options.LEAVE.description": "（离开）",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.WON.description": "这里的水匪被你杀光了，你捡到一卷写着《大千录》的奇怪竹简还有些散落的财物……",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.WON.options.TAKE.title": "（拾取）",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.WON.options.TAKE.description": "获得[gold]大千录残卷[/gold]和[blue]{Gold}[/blue]金币。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.WON.options.GOLD.title": "（只拿钱）",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.WON.options.GOLD.description": "获得[blue]{Gold}[/blue]金币。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.GOLD_END.description": "你把散落的钱财揣进怀里，拍了拍身上的尘土，继续赶路。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.YIELD_END.description": "拍了拍身上的尘土，继续赶路。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_LONGMEN_WATER_BANDITS.pages.END.description": "你把竹简塞进怀里，拍了拍身上的尘土，继续赶路。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.title": "正德寺",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.INITIAL.description": "恍惚间，一座[sine]香烟缭绕[/sine]，枣红墙壁的庄严寺庙映入眼帘。高大的寺门上方的黑色牌匾，用朱红色写上了三个大字，[red][jitter]正德寺[/jitter][/red]。在鼎盛的香火下，整个寺庙被[sine]白烟[/sine]笼罩，看起来十分的仙气十足。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.INITIAL.options.ENTER.title": "（进入）",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.INITIAL.options.ENTER.description": "进去看看。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.INITIAL.options.LEAVE.title": "（离开）",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.INITIAL.options.LEAVE.description": "这个寺庙看起来总觉得[red]不对劲[/red]，还是去城里逛逛吧。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.CAUGHT.description": "寺庙里的和尚似乎不是你想象中的那样，被你不小心撞见似乎在修炼一种[jitter][purple]难以理解的奇怪功法[/purple][/jitter]。你觉得脑袋有点[jitter][purple]分不清幻觉还是现实[/purple][/jitter]，刚要开溜，被几个和尚叫住了...",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.CAUGHT.options.FIGHT.title": "得罪了方丈还想走？",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.CAUGHT.options.FIGHT.description": "[red]（战斗）[/red]",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.ESCAPED.description": "脱了和尚的纠缠，你[jitter]迅速的[/jitter]离开了。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.ESCAPED.options.LEAVE.title": "离开。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.ESCAPED.options.LEAVE.description": "（离开）",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.DOG.description": "马路上有条流浪狗总是跟着你，你试着喂它吃了点馒头，它开心的摇起了尾巴。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.DOG.options.ADOPT.title": "（收养）",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.DOG.options.ADOPT.description": "获得[gold]「馒头先吃」[/gold]。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.ESCAPED_END.description": "你头也不回地[jitter]冲出[/jitter]了山门。",
  "LIHUOWANG2_EVENT_LIHUOWANG2_ZHENGDE_TEMPLE.pages.DOG_END.description": "你想跟就随你跟着吧，正好可以用来[jitter]试毒[/jitter]~既然你喜欢吃馒头，以后就叫你[gold]“馒头”[/gold]好了..."
}
